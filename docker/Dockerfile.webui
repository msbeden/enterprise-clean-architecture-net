# Multi-stage Dockerfile for Enterprise Clean Architecture React SPA WebUI

# Stage 1: Build stage
FROM node:20-alpine AS build
WORKDIR /app

# Copy package files and install dependencies
COPY src/Presentation/Enterprise.WebUI/package*.json ./
RUN npm ci

# Copy full application source and build production bundle
COPY src/Presentation/Enterprise.WebUI/ ./
RUN npm run build

# Stage 2: Production runtime stage with Nginx
FROM nginx:alpine AS final

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built dist files from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
